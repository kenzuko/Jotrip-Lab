{
  "schema_version": "1.0",
  "modules": {
    "hotel_forward": {
      "trigger_states": ["NOT_AUTOMATED", "DEGRADED", "BLOCKED", "INSUFFICIENT_COVERAGE"],
      "fallback_mode": "RESEARCH_ON_DEMAND",
      "preferred_sources": ["HOTEL_DIRECT", "BOOKING_PUBLIC", "COMPARABLE_OTA"],
      "allowed_outputs": ["direct availability observation", "public rate observation", "restriction observation", "source-specific evidence"],
      "forbidden_outputs": ["Forward Compression score", "island occupancy", "sold-out conclusion from parser failure", "trend without comparable historical snapshots"],
      "exact_missing_output": "ÁP LỰC SIẾT NGUỒN PHÒNG TƯƠNG LAI - KHÔNG XUẤT ĐIỂM"
    },
    "airfare": {
      "trigger_states": ["NOT_AUTOMATED", "DEGRADED", "BLOCKED", "INSUFFICIENT_COVERAGE", "PARTIAL_READY"],
      "fallback_mode": "RESEARCH_ON_DEMAND",
      "preferred_sources": ["AIRLINE_DIRECT", "AIRLINE_BRANDED_MARKETPLACE", "COMPARABLE_OTA"],
      "allowed_outputs": ["route-specific public fare observation", "fare availability signal", "source-specific price floor"],
      "forbidden_outputs": ["Airfare Pressure score from public deal pages", "cross-route price comparison without currency/product normalization", "trend without compatible basket snapshots"],
      "exact_missing_output": "ÁP LỰC GIÁ VÉ MÁY BAY - KHÔNG XUẤT"
    },
    "social_intent": {
      "trigger_states": ["NOT_AUTOMATED", "DEGRADED", "BLOCKED", "RESEARCH_ON_DEMAND"],
      "fallback_mode": "RESEARCH_ON_DEMAND",
      "preferred_sources": ["Reddit", "Tripadvisor", "public forums", "public review platforms", "search-indexed public social pages"],
      "market_language_matrix": [
        ["Vietnam", "Vietnamese"],
        ["Korea", "Korean"],
        ["Russia_CIS", "Russian"],
        ["Taiwan_HK_China", "Traditional/Simplified Chinese"],
        ["SEA", "English/local languages where available"],
        ["Western", "English"]
      ],
      "allowed_outputs": ["quoted traveller evidence", "repeated narrative", "decision friction", "intent theme"],
      "forbidden_outputs": ["post count equals demand", "single post equals market narrative", "platform silence equals no interest"],
      "exact_missing_output": "SOCIAL/INTENT - CHƯA ĐỦ ĐỘ PHỦ ĐỂ KẾT LUẬN XU HƯỚNG"
    }
  },
  "global_rule": "MARKET CONDITION != DATA SYSTEM CONDITION"
}
